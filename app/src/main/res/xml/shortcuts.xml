<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the Scroll Reader icon on the home screen. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="toggle_service"
        android:shortcutLongLabel="@string/shortcut_toggle_long"
        android:shortcutShortLabel="@string/shortcut_toggle_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.nerpudino.scrollreader.ToggleShortcutActivity"
            android:targetPackage="com.nerpudino.scrollreader" />
    </shortcut>
</shortcuts>
